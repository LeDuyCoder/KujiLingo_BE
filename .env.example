# Environment variables declared in this file are NOT automatically loaded by Prisma.
# See: https://pris.ly/prisma-config-env-vars

# =====================
# Database
# =====================
DATABASE_URL="postgresql://user:password@localhost:5432/kujilingo?schema=public"

# =====================
# Google OAuth 2.0
# =====================
# Lấy tại: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
# Lấy bằng cách chạy flow GET /api/v1/auth/google (chỉ dùng một lần trong môi trường dev)
GOOGLE_REFRESH_TOKEN=

# =====================
# Mail Sender Identity
# =====================
MAIL_FROM_EMAIL=your-gmail@gmail.com
MAIL_FROM_NAME=KujiLingo

# =====================
# Frontend
# =====================
FRONTEND_URL=http://localhost:5173
