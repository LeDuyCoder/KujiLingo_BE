model shop_items {
  id                  String                @id @db.Uuid
  name                String?               @db.VarChar
  description         String?
  image               String?               @db.VarChar
  preview_image       String?               @db.VarChar
  item_type           ItemType?
  rarity              ItemRarity?
  price               Int?
  currency            CurrencyType?
  status              ItemStatus?
  is_limited          Boolean?
  stock               Int?
  created_at          DateTime?             @db.Timestamp(6)
  purchase_histories  purchase_histories[]
  shop_banners        shop_banners[]
  user_equipped_items user_equipped_items[]
  user_shop_items     user_shop_items[]

  @@index([item_type])
  @@index([item_type, rarity])
  @@index([rarity])
}

