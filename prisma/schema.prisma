generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model achievements {
  id                String              @id @db.Uuid
  title             String              @db.VarChar
  description       String
  icon              String              @db.VarChar
  type              AchievementType
  condition_value   Int
  reward_exp        Int?                @default(0)
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  user_achievements user_achievements[]

  @@index([type])
}

model courses {
  id          String    @id @db.Uuid
  title       String?   @db.VarChar
  description String?
  image       String?   @db.VarChar
  order_no    Int?
  deleted_at  DateTime? @db.Timestamp(6)
  lessons     lessons[]

  @@index([order_no])
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model example_sentences {
  id            String        @id @db.Uuid
  vocabulary_id String?       @db.Uuid
  japanese      String?
  hiragana      String?
  translation   String?
  vocabularies  vocabularies? @relation(fields: [vocabulary_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([vocabulary_id])
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model favorite_vocabularies {
  user_id       String       @db.Uuid
  vocabulary_id String       @db.Uuid
  users         users        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vocabularies  vocabularies @relation(fields: [vocabulary_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, vocabulary_id])
  @@index([vocabulary_id])
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model folder_system_vocabularies {
  folder_id     String       @db.Uuid
  vocabulary_id String       @db.Uuid
  folders       folders      @relation(fields: [folder_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vocabularies  vocabularies @relation(fields: [vocabulary_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([folder_id, vocabulary_id])
  @@index([vocabulary_id])
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model folder_user_vocabularies {
  folder_id          String            @db.Uuid
  user_vocabulary_id String            @db.Uuid
  folders            folders           @relation(fields: [folder_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_vocabularies  user_vocabularies @relation(fields: [user_vocabulary_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([folder_id, user_vocabulary_id])
  @@index([user_vocabulary_id])
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model folders {
  id                         String                       @id @db.Uuid
  user_id                    String?                      @db.Uuid
  name                       String?                      @db.VarChar
  color                      String?                      @db.VarChar
  icon                       String?                      @db.VarChar
  folder_system_vocabularies folder_system_vocabularies[]
  folder_user_vocabularies   folder_user_vocabularies[]
  users                      users?                       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id])
}

model gem_packages {
  id                   String                 @id @db.Uuid
  title                String?                @db.VarChar
  description          String?
  gem_amount           Int?
  bonus_gem            Int?                   @default(0)
  price                Decimal?               @db.Decimal
  image                String?                @db.VarChar
  is_popular           Boolean?               @default(false)
  is_best_value        Boolean?               @default(false)
  sort_order           Int?
  is_active            Boolean?               @default(true)
  created_at           DateTime?              @db.Timestamp(6)
  payment_transactions payment_transactions[]

  @@index([is_active])
  @@index([sort_order])
}

model gem_promotions {
  id                   String                 @id @db.Uuid
  title                String?                @db.VarChar
  description          String?
  bonus_percent        Int?
  start_at             DateTime?              @db.Timestamp(6)
  end_at               DateTime?              @db.Timestamp(6)
  is_active            Boolean?               @default(true)
  created_at           DateTime?              @db.Timestamp(6)
  payment_transactions payment_transactions[]

  @@index([is_active])
  @@index([start_at, end_at])
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model grammar_examples {
  id             String          @id @db.Uuid
  grammar_id     String?         @db.Uuid
  japanese       String?
  translation    String?
  grammar_points grammar_points? @relation(fields: [grammar_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([grammar_id])
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model grammar_points {
  id               String             @id @db.Uuid
  lesson_id        String?            @db.Uuid
  title            String?            @db.VarChar
  structure        String?
  meaning          String?
  usage            String?
  jlpt             JLPTLevel?
  grammar_examples grammar_examples[]
  lessons          lessons?           @relation(fields: [lesson_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([lesson_id, jlpt])
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model kanji_vocabularies {
  kanji_id      String       @db.Uuid
  vocabulary_id String       @db.Uuid
  kanjis        kanjis       @relation(fields: [kanji_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vocabularies  vocabularies @relation(fields: [vocabulary_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([kanji_id, vocabulary_id])
  @@index([vocabulary_id])
}

model kanjis {
  id                 String               @id @db.Uuid
  kanji              String?              @db.VarChar
  meaning            String?
  onyomi             String?              @db.VarChar
  kunyomi            String?              @db.VarChar
  stroke_count       Int?
  jlpt               JLPTLevel?
  kanji_vocabularies kanji_vocabularies[]

  @@index([jlpt])
  @@index([kanji])
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model learning_progress {
  id            String          @id @db.Uuid
  user_id       String?         @db.Uuid
  vocabulary_id String?         @db.Uuid
  status        LearningStatus?
  mastery       Float?
  correct_count Int?
  wrong_count   Int?
  last_review   DateTime?       @db.Timestamp(6)
  next_review   DateTime?       @db.Timestamp(6)
  users         users?          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vocabularies  vocabularies?   @relation(fields: [vocabulary_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, vocabulary_id], map: "learning_progress_user_id_vocabulary_id_idx")
  @@index([user_id, next_review, status])
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model lessons {
  id             String           @id @db.Uuid
  course_id      String?          @db.Uuid
  title          String?          @db.VarChar
  description    String?
  order_no       Int?
  grammar_points grammar_points[]
  courses        courses?         @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  topics         topics[]

  @@index([course_id, order_no])
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model payment_transactions {
  id                      String             @id @db.Uuid
  user_id                 String?            @db.Uuid
  package_id              String?            @db.Uuid
  promotion_id            String?            @db.Uuid
  payment_method          PaymentMethod?
  payment_status          PaymentStatus?
  amount                  Decimal?           @db.Decimal
  gem_amount              Int?
  bonus_gem               Int?
  total_gem               Int?
  transaction_code        String?            @unique @db.VarChar
  provider_transaction_id String?            @db.VarChar
  payment_url             String?
  provider_response       String?
  expired_at              DateTime?          @db.Timestamp(6)
  paid_at                 DateTime?          @db.Timestamp(6)
  created_at              DateTime?          @db.Timestamp(6)
  updated_at              DateTime?          @db.Timestamp(6)
  gem_packages            gem_packages?      @relation(fields: [package_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gem_promotions          gem_promotions?    @relation(fields: [promotion_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                   users?             @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wallet_histories        wallet_histories[]

  @@index([created_at])
  @@index([package_id])
  @@index([payment_status])
  @@index([provider_transaction_id])
  @@index([transaction_code])
  @@index([user_id])
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model purchase_histories {
  id           String        @id @db.Uuid
  user_id      String?       @db.Uuid
  shop_item_id String?       @db.Uuid
  price        Int?
  currency     CurrencyType?
  purchased_at DateTime?     @db.Timestamp(6)
  shop_items   shop_items?   @relation(fields: [shop_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users        users?        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([purchased_at])
  @@index([user_id])
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model pvp_match_histories {
  id                                          String     @id @db.Uuid
  player1_id                                  String?    @db.Uuid
  player2_id                                  String?    @db.Uuid
  winner_id                                   String?    @db.Uuid
  player1_score                               Int?
  player2_score                               Int?
  player1_correct                             Int?
  player2_correct                             Int?
  player1_time                                Int?
  player2_time                                Int?
  jlpt                                        JLPTLevel?
  question_count                              Int?
  played_at                                   DateTime?  @db.Timestamp(6)
  users_pvp_match_histories_player1_idTousers users?     @relation("pvp_match_histories_player1_idTousers", fields: [player1_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_pvp_match_histories_player2_idTousers users?     @relation("pvp_match_histories_player2_idTousers", fields: [player2_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_pvp_match_histories_winner_idTousers  users?     @relation("pvp_match_histories_winner_idTousers", fields: [winner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([jlpt])
  @@index([played_at])
  @@index([player1_id])
  @@index([player2_id])
  @@index([winner_id])
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
