  purchased_at DateTime?   @db.Timestamp(6)
  shop_items   shop_items? @relation(fields: [shop_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users        users?      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, shop_item_id], map: "user_shop_items_user_id_shop_item_id_idx")
  @@index([user_id])
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model user_vocabularies {
  id                       String                     @id @db.Uuid
  user_id                  String?                    @db.Uuid
  kanji                    String?                    @db.VarChar
  hiragana                 String?                    @db.VarChar
  romaji                   String?                    @db.VarChar
  meaning                  String?
  note                     String?
  image                    String?                    @db.VarChar
  audio                    String?                    @db.VarChar
  created_at               DateTime?                  @db.Timestamp(6)
  folder_user_vocabularies folder_user_vocabularies[]
  users                    users?                     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id, created_at])
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model user_wallets {
  user_id    String    @id @db.Uuid
  coins      Int?      @default(0)
  gems       Int?      @default(0)
  updated_at DateTime? @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  id                                                        String                        @id @db.Uuid
  email                                                     String?                       @unique @db.VarChar
  password_hash                                             String?                       @db.VarChar
  display_name                                              String?                       @db.VarChar
  avatar                                                    String?                       @db.VarChar
  level                                                     Int?
  exp                                                       Int?
  streak                                                    Int?
  accepted_terms                                            Boolean?                      @default(false)
  jlpt_target_level                                         JLPTLevel?
  role                                                      String                        @default("user") @db.VarChar
  status                                                    String?                       @default("pending_verification") @db.VarChar
  email_verified                                            Boolean?                      @default(false)
  email_verified_at                                         DateTime?                     @db.Timestamp(6)
  last_login_at                                             DateTime?                     @db.Timestamp(6)
  created_at                                                DateTime?                     @default(now()) @db.Timestamp(6)
  updated_at                                                DateTime?                     @db.Timestamp(6)
  deleted_at                                                DateTime?                     @db.Timestamp(6)
  email_verification_tokens                                 email_verification_tokens[]
  favorite_vocabularies                                     favorite_vocabularies[]
  folders                                                   folders[]
  learning_progress                                         learning_progress[]
  payment_transactions                                      payment_transactions[]
  purchase_histories                                        purchase_histories[]
  pvp_match_histories_pvp_match_histories_player1_idTousers pvp_match_histories[]         @relation("pvp_match_histories_player1_idTousers")
  pvp_match_histories_pvp_match_histories_player2_idTousers pvp_match_histories[]         @relation("pvp_match_histories_player2_idTousers")
  pvp_match_histories_pvp_match_histories_winner_idTousers  pvp_match_histories[]         @relation("pvp_match_histories_winner_idTousers")
  review_histories                                          review_histories[]
  user_achievements                                         user_achievements[]
  user_equipped_items                                       user_equipped_items[]
  user_pvp_statistics                                       user_pvp_statistics?
  user_shop_items                                           user_shop_items[]
  user_vocabularies                                         user_vocabularies[]
  user_wallets                                              user_wallets?
  wallet_histories                                          wallet_histories[]
  refresh_tokens                                            refresh_tokens[]
  password_reset_tokens                                     password_reset_tokens[]
  admin_audit_logs                                          admin_audit_logs[]
}

model password_reset_tokens {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  token_hash  String    @unique @db.VarChar
  expires_at  DateTime  @db.Timestamp(6)
  consumed_at DateTime? @db.Timestamp(6)
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model admin_audit_logs {
  id           String   @id @default(uuid()) @db.Uuid
  admin_id     String   @db.Uuid
  action       String   @db.VarChar
  entity_id    String?  @db.VarChar
  before_state Json?
  after_state  Json?
  created_at   DateTime @default(now()) @db.Timestamp(6)
  users        users    @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([created_at(sort: Desc)])
  @@index([admin_id, created_at(sort: Desc)])
}

model email_verification_tokens {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  token_hash  String    @db.VarChar
  expires_at  DateTime  @db.Timestamp(6)
  consumed_at DateTime? @db.Timestamp(6)
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token_hash])
}

model login_attempts {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @db.VarChar
  ip_address String   @db.VarChar
  succeeded  Boolean
  user_agent String?
  created_at DateTime @default(now()) @db.Timestamp(6)

  @@index([email, created_at])
}

model refresh_tokens {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  token_hash  String   @unique @db.VarChar
  device_id   String?  @db.VarChar
  device_name String?  @db.VarChar
  ip_address  String   @db.VarChar
  user_agent  String?
  expires_at  DateTime @db.Timestamp(6)
  is_revoked  Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model vocabularies {
  id                         String                       @id @db.Uuid
  kanji                      String?                      @db.VarChar
  hiragana                   String?                      @db.VarChar
  romaji                     String?                      @db.VarChar
  word_type                  WordType?
  jlpt                       JLPTLevel?
  frequency                  Int?
  audio                      String?                      @db.VarChar
  image                      String?                      @db.VarChar
  created_at                 DateTime?                    @db.Timestamp(6)
  example_sentences          example_sentences[]
  favorite_vocabularies      favorite_vocabularies[]
  folder_system_vocabularies folder_system_vocabularies[]
  kanji_vocabularies         kanji_vocabularies[]
  learning_progress          learning_progress[]
  review_histories           review_histories[]
  topic_vocabularies         topic_vocabularies[]
  vocabulary_meanings        vocabulary_meanings[]

  @@index([hiragana])
  @@index([jlpt, frequency])
  @@index([jlpt])
  @@index([kanji])
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model vocabulary_meanings {
  id            String        @id @db.Uuid
  vocabulary_id String?       @db.Uuid
  language      String?       @db.VarChar
  meaning       String?
  display_order Int?
  vocabularies  vocabularies? @relation(fields: [vocabulary_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([vocabulary_id, display_order])
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model wallet_histories {
  id                     String                 @id @db.Uuid
  user_id                String?                @db.Uuid
  transaction_type       WalletTransactionType?
  coin_change            Int?                   @default(0)
  gem_change             Int?                   @default(0)
  balance_coin           Int?
  balance_gem            Int?
  payment_transaction_id String?                @db.Uuid
  note                   String?
  created_at             DateTime?              @db.Timestamp(6)
  payment_transactions   payment_transactions?  @relation(fields: [payment_transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                  users?                 @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at])
  @@index([payment_transaction_id])
  @@index([user_id])
}

